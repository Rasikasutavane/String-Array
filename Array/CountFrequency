package array;

public class CountFrequency {

	public static void main(String[] args) {
		
 int [] arr= { 80,90,70,70,60,80};
 int count =1;
  
  for( int i=0;i<arr.length;i++) {
	 
	  for( int j=i+1;j<arr.length;j++) {
	  if( arr[i]==arr[j]) {
		  count++;
		 
		  }
	  } 
  }
  System.out.println(" Count "+count);
	}

}

